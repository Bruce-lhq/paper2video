{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["paper", "mode", "scenes"],
  "properties": {
    "paper": {
      "type": "object",
      "required": ["title", "lang"],
      "properties": {
        "title": {"type": "string"},
        "authors": {"type": "string"},
        "lang": {"enum": ["en", "zh"]}
      }
    },
    "mode": {"enum": ["single", "compare"]},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "shots"],
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]+(-[a-z0-9-]+)?$"},
          "title": {"type": "string"},
          "type": {"enum": ["title", "intro", "method", "experiment", "conclusion"]},
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "intent", "narration_zh", "subtitle_en"],
              "properties": {
                "kind": {"enum": ["title", "formula", "figure", "axis", "flow", "annotation", "note", "transition"]},
                "intent": {"type": "string"},
                "primitives": {"type": "array", "items": {"type": "string"}},
                "narration_zh": {"type": "string", "minLength": 10},
                "subtitle_en": {"type": "string", "minLength": 5},
                "fig_ref": {"type": ["string", "null"]},
                "figure_origin": {"type": ["string", "null"]},
                "formulas": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
